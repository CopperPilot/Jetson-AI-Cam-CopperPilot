(version 1)

# ==============================================================================
# JLCPCB 8-Layer High-Yield Custom Design Rules for Jetson-AI-Cam-CopperPilot
# Target Process: JLCPCB Standard & High-Precision Multilayer (JLC08161H-3313)
# ==============================================================================

# Rule 1: Drill-to-Drill edge spacing across DIFFERENT nets (min 0.50 mm)
# Prevents internal conductive anodic filament (CAF) growth, delamination, and drill bit breakage.
(rule "JLCPCB_Different_Net_Hole_To_Hole"
   (constraint hole_to_hole (min 0.50mm))
   (condition "A.Net != B.Net"))

# Rule 2: Via-to-Via hole spacing on the SAME net (min 0.254 mm / 10 mil)
# Allows high-density RF / power plane via stitching while preventing drill bit web cracking.
(rule "JLCPCB_Same_Net_Via_Hole_To_Hole"
   (constraint hole_to_hole (min 0.254mm))
   (condition "A.Net == B.Net && A.isType('via') && B.isType('via')"))

# Rule 3: Strict prohibition of co-located / duplicate drill hits (min 0.20 mm)
# Eliminates CNC drill bit breakage, gouging, and double-hit barrel damage.
(rule "JLCPCB_Zero_CoLocated_Holes"
   (constraint hole_to_hole (min 0.20mm))
   (condition "A.Net == B.Net && A.isType('via') && B.isType('via') && (A.Position == B.Position)"))

# Rule 4: Outer copper traces, vias, and pads to board edge clearance (min 0.25 mm)
# Protects conductors from CNC router bit tearing along perimeter cuts.
(rule "JLCPCB_Copper_To_Board_Edge"
   (constraint edge_clearance (min 0.25mm))
   (condition "A.isType('track') || A.isType('via') || A.isType('pad')"))

# Rule 5: Internal copper zones and power/GND planes to board edge clearance (min 0.35 mm)
# Prevents copper edge exposure, delamination, and chassis short circuits.
(rule "JLCPCB_Zone_To_Board_Edge"
   (constraint edge_clearance (min 0.35mm))
   (condition "A.isType('zone')"))

# Rule 6: Non-plated through hole (NPTH) to copper clearance (min 0.25 mm)
# Prevents tool tearing and shorting to mounting screws and mechanical fasteners.
(rule "JLCPCB_NPTH_To_Copper_Clearance"
   (constraint hole_clearance (min 0.25mm))
   (condition "A.isType('pad') && !A.isPlated()"))

# Rule 7: Silkscreen clearance to exposed solder mask apertures (min 0.15 mm)
# Prevents legend ink from bleeding onto SMD pads and causing solder wetting failures.
(rule "JLCPCB_Silkscreen_To_Mask_Clearance"
   (constraint silk_clearance (min 0.15mm)))

# Rule 8: Minimum track width for standard fabrication (min 0.09 mm / 3.54 mil)
(rule "JLCPCB_Min_Track_Width"
   (constraint track_width (min 0.09mm)))

# Rule 9: Minimum copper-to-copper electrical clearance (min 0.09 mm / 3.54 mil)
(rule "JLCPCB_Min_Electrical_Clearance"
   (constraint clearance (min 0.09mm)))
