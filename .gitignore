# For PCBs designed using KiCad: https://www.kicad.org/
# Format documentation: https://kicad.org/help/file-formats/

# KiCad temporary & autosave files
*.000
*.bak
*.bck
*.kicad_pcb-bak
*.kicad_sch-bak
*-backups
*-cache*
*-bak
*-bak*
*~
~*
_autosave-*
\#auto_saved_files\#
\#auto_saved_files#
*.tmp
*-save.pro
*-save.kicad_pcb
fp-info-cache
~*.lck
*.lck

# Autorouter files (exported from Pcbnew)
*.dsn
*.ses

# Exported files & exclusions
*.xml
*.csv
*.zip
!manufacturing/*.csv
!manufacturing/gerbers.zip
!review/trial-outputs/*.csv

# Archived Backups (KiCad 6.0+)
**/*-backups/*.zip

# Local git-based history (KiCad 9.0+)
.history
.history/

# Local project settings
*.kicad_prl

# CopperPilot internal metadata, scratch, & staging (must never be committed)
.copperpilot/
.copperpilot
**/.copperpilot/**

# Python bytecode & test caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
*.log

# Scratch test runner files
.drc_test_tmp.json
.erc_test_tmp.json

# OS and Editor temporary files
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/
